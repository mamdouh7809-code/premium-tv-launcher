<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Noir" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#08090C</item>
        <item name="android:colorAccent">#BFD5FF</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">#08090C</item>
        <item name="android:navigationBarColor">#08090C</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
